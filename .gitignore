# Data — 원본/가공 데이터는 git에서 제외
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md
data/processed/*
!data/processed/.gitkeep
!data/processed/demo_sample.pkl
!data/processed/demo_result.csv
!data/processed/shap_demo.png

# Models — 직렬화 모델은 별도 관리
models/*.joblib
models/*.pkl
!models/.gitkeep
!models/README.md
!models/threshold_table.csv
!models/shap_top20.csv
!models/model_card.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Streamlit
.streamlit/secrets.toml

